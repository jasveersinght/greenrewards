# Database
DATABASE_URL="postgresql://greenrewards:greenrewards_dev@localhost:5432/greenrewards"

# JWT Session
JWT_SECRET="change-me-to-a-long-random-string-in-production"
SESSION_COOKIE_NAME="gr_session"
SESSION_MAX_AGE_SECONDS=604800

# OTP
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5
