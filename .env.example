# App & Demo Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
DEMO_FAST_SETTLE="true"
ENABLE_DEV_ROLE_SWITCH="true"

# Email (stub in dev — OTP printed to console)
SMTP_HOST=""
